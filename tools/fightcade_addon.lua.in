-- Input grader as an add-on of Fightcade's training mode (fbneo-training-mode), written by
-- tools/install-fightcade-addon.sh. The training mode runs one callback per emulator hook and
-- calls everything in its `registers` lists from them, so the grader adds itself there instead of
-- replacing them. The grader's code is loaded from the repository below.

local GRADER = [[@GRADER@]]
package.path = GRADER .. "lua/?.lua;" .. GRADER .. "lua/?/init.lua;" .. package.path

local platform = require("input_grader.platform.fbneo").new()
platform.on_before = function(fn)
  table.insert(registers.registerbefore, fn)
end
platform.on_frame = function(fn)
  table.insert(registers.registerafter, fn)
end
platform.on_draw = function(fn)
  table.insert(registers.guiregister, fn)
end

local app = require("input_grader.games.sfiii3").build(platform, { log_path = GRADER .. "logs/attempts.csv" })
require("input_grader.core.run").attach(platform, app)
print("input_grader loaded: M menu, H hide, Page Up/Down history")
