-- Generated by input-grader's tools/install-training-launcher.sh: runs 3rd_training_lua and the
-- input grader in one Lua state. FBNeo keeps one callback per hook, so the grader's hook
-- multiplexer is installed first and both scripts' callbacks run.

local GRADER = [[@GRADER@]]
package.path = GRADER .. "lua/?.lua;" .. GRADER .. "lua/?/init.lua;" .. package.path

require("input_grader.core.hooks").install()
dofile("3rd_training.lua")

local platform = require("input_grader.platform.fbneo").new()
local app = require("input_grader.games.sfiii3").build(platform, { log_path = GRADER .. "logs/attempts.csv" })
require("input_grader.core.run").attach(platform, app)
platform.print("input_grader loaded with 3rd_training_lua: Alt+7 bench, Alt+8 target move, Alt+9 hide")
